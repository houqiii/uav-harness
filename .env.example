DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low
# Endpoint is fixed to https://api.deepseek.com; no third-party gateway fallback.
# Required if the HTTP service binds beyond loopback.
HARNESS_API_TOKEN=


# Shared visual planning backbone (official DashScope endpoint).
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional Drone4D deployment; local SDK/frontend source is prepared by mac-sandbox.sh.
DRONE4D_URL=https://drone4d.agentnetwork.org.cn
# DRONE4D_SOURCE=/absolute/path/ANet-Drone4D
